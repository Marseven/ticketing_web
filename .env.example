APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY=

# E-Billing
EBILLING_USERNAME=
EBILLING_SHARED_KEY=
EBILLING_SERVER_URL=
EBILLING_POST_URL=
# Auth e-billing : 'oauth' (OBLIGATOIRE — Basic refuse depuis les echeances
# billing-easy : Lab 30/06/2026, Prod 31/08/2026). 'basic' = fallback historique.
EBILLING_AUTH_MODE=oauth
# OAuth2 client_credentials (billing-easy). Token endpoint selon l'environnement :
#   Lab  : https://lab.billing-easy.net/oauth/token
#   Prod : https://billing-easy.com/oauth/token
EBILLING_OAUTH_TOKEN_URL=https://lab.billing-easy.net/oauth/token
EBILLING_OAUTH_CLIENT_ID=
EBILLING_OAUTH_CLIENT_SECRET=
# Scopes (prefixe ebilling-api/, separes par des espaces). Vide = defaut du code.
EBILLING_OAUTH_SCOPE="ebilling-api/invoice:create ebilling-api/invoice:read ebilling-api/payment:create ebilling-api/payment:read"
# Webhook hardening (comma-separated IPs and/or shared secret).
# Leave empty to keep the legacy open behavior (logged as a warning).
# IP de rappel e-billing observées (AWS us-east-1 — peuvent tourner ; ajouter
# toute nouvelle IP vue dans les logs sous "ip_candidates").
EBILLING_WEBHOOK_ALLOWED_IPS=35.172.11.149,18.209.39.112,3.85.54.235,3.212.158.70
EBILLING_WEBHOOK_SECRET=

# Frais de service (e-billing) en % — facturés au client uniquement quand
# l'événement est configuré service_fee_bearer=customer (sinon plateforme absorbe).
SERVICE_FEE_PERCENT=2.5

# Import legacy MyTicketO (base leweb_*) — charger le dump puis renseigner :
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=myticketo_legacy
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# Mesure d'audience — none | plausible | umami | ga4
# Plausible et Umami ne déposent aucun cookie et se chargent directement.
# Google Analytics (ga4) dépose des cookies : une bannière de consentement
# apparaît et rien n'est chargé tant que le visiteur n'a pas accepté.
ANALYTICS_PROVIDER=none
ANALYTICS_DOMAIN=
ANALYTICS_SITE_ID=
ANALYTICS_SCRIPT_URL=
